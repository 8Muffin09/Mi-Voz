rules_version = '2';

// Reglas de seguridad de Mi Voz.
//
// Principios:
// - Toda la información de un niño vive bajo children/{childId}.
// - Solo los adultos en children/{childId}.memberUids pueden leerla o escribirla.
// - El administrador (ownerUid) es quien gestiona los vínculos.
// - Un adulto solo puede unirse con una invitación válida, de un solo uso y
//   sin caducar, y solo puede agregarse a sí mismo.
// - Las notificaciones y su resultado los escribe la Cloud Function (Admin SDK),
//   nunca el cliente.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function childPath(childId) {
      return /databases/$(database)/documents/children/$(childId);
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function linkPath(childId, adultUid) {
      return /databases/$(database)/documents/children/$(childId)/caregiver_links/$(adultUid);
    }

    function isFamilyAdult(familyId) {
      return signedIn() && familyId is string
        && uid() in get(familyPath(familyId)).data.adultUids;
    }

    function isFamilyOwner(familyId) {
      return signedIn() && familyId is string
        && get(familyPath(familyId)).data.ownerUid == uid();
    }

    function isClassOwner(classId) {
      return signedIn() && classId is string
        && get(classPath(classId)).data.ownerUid == uid();
    }

    function validName(data, maxSize) {
      return data.name is string && data.name.size() > 0
        && data.name.size() <= maxSize;
    }

    function isMember(childId) {
      return signedIn() && uid() in get(childPath(childId)).data.memberUids;
    }

    function isOwner(childId) {
      return signedIn() && get(childPath(childId)).data.ownerUid == uid();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validRole(role) {
      return role in ['madre', 'padre', 'tutor', 'docente', 'cuidador'];
    }

    // Invitación sin usar y vigente para ese niño (estado previo al lote).
    function validInvite(code, childId) {
      let inv = get(invitationPath(code)).data;
      return inv.childId == childId
        && inv.usedBy == null
        && inv.expiresAt > request.time;
    }

    function optionalString(data, key, maxSize) {
      return data.get(key, null) == null
        || (data[key] is string && data[key].size() <= maxSize);
    }

    // ---------------------------------------------------------------- users
    // Perfil personal: solo su dueño lo lee o escribe. Las "experiencias"
    // (familia / docente) no otorgan acceso a ningún niño: ese acceso solo se
    // obtiene con un vínculo verificado (invitación).
    match /users/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn()
        && uid() == userId
        && request.resource.data.uid == userId
        // El correo guardado es el de la sesión (no el de otra persona).
        && request.resource.data.email is string
        && request.resource.data.email.lower()
            == string(request.auth.token.get('email', '')).lower()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'lastName', 'avatar',
          'avatarColor', 'photo', 'schoolName', 'groupName', 'teacherTitle',
          'experiences', 'createdAt'
        ])
        && validRole(request.resource.data.role)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && optionalString(request.resource.data, 'lastName', 40)
        // Identificador del avatar ilustrado (o emoji de versiones anteriores).
        && optionalString(request.resource.data, 'avatar', 40)
        && optionalString(request.resource.data, 'photo', 300)
        && optionalString(request.resource.data, 'schoolName', 80)
        && optionalString(request.resource.data, 'groupName', 80)
        && optionalString(request.resource.data, 'teacherTitle', 20)
        && (request.resource.data.get('avatarColor', null) == null
            || request.resource.data.avatarColor is int)
        && (request.resource.data.get('experiences', null) == null
            || (request.resource.data.experiences is list
                && request.resource.data.experiences.size() <= 2
                && request.resource.data.experiences.toSet()
                    .hasOnly(['guardian', 'teacher'].toSet())));
    }

    // ------------------------------------------------------------- children
    match /children/{childId} {

      function responsibleIsMember() {
        return request.resource.data.get('responsibleUid', null) == null
          || request.resource.data.responsibleUid in request.resource.data.memberUids;
      }

      // Un adulto vinculado solo puede marcarse a sí mismo o dejar de
      // acompañar si era él el responsable.
      function responsibleSelfOnly() {
        return !changedKeys().hasAny(['responsibleUid'])
          || request.resource.data.responsibleUid == uid()
          || (request.resource.data.responsibleUid == null
              && resource.data.get('responsibleUid', null) == uid());
      }

      allow read: if signedIn() && uid() in resource.data.memberUids;

      function validChildProfile() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && optionalString(request.resource.data, 'lastName', 40)
          && optionalString(request.resource.data, 'photo', 300)
          // A quién avisar si nadie acompaña: solo cambia en la rama del
          // administrador (las demás ramas no permiten tocar estos campos).
          && request.resource.data.get('noCompanionRule', 'admin')
              in ['admin', 'chosen', 'all']
          && request.resource.data.get('backupUids', []) is list
          && request.resource.data.get('backupUids', []).size() <= 20;
      }

      // Solo un adulto con sesión crea perfiles: queda como único miembro o,
      // si lo crea en su familia, los miembros son exactamente los adultos de
      // esa familia. Nunca nace vinculado a clases.
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && validChildProfile()
        && request.resource.data.get('classIds', []).size() == 0
        && (
          (request.resource.data.get('familyId', null) == null
            && request.resource.data.memberUids == [uid()])
          ||
          (isFamilyAdult(request.resource.data.familyId)
            && request.resource.data.memberUids
                == get(familyPath(request.resource.data.familyId)).data.adultUids)
        );

      function classIdsNotGrown() {
        return request.resource.data.get('classIds', []).toSet()
          .difference(resource.data.get('classIds', []).toSet()).size() == 0;
      }

      // La familia solo se asigna una vez (actualización de datos antiguos)
      // y a una familia del propio adulto.
      function familyUnchangedOrAdopted() {
        return !changedKeys().hasAny(['familyId'])
          || (resource.data.get('familyId', null) == null
              && isFamilyAdult(request.resource.data.familyId));
      }

      allow update: if signedIn() && (
        // Administrador: puede editar todo, quitar adultos (no agregarlos)
        // y asignar como responsable a cualquier adulto vinculado.
        (resource.data.ownerUid == uid()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.hasAll([uid()])
          && responsibleIsMember()
          && classIdsNotGrown()
          && familyUnchangedOrAdopted()
          && validChildProfile())
        ||
        // Adulto vinculado: nombre, avatar/foto, ajustes sensoriales y
        // "Estoy acompañando" (solo a sí mismo). No puede tocar vínculos.
        (uid() in resource.data.memberUids
          && changedKeys().hasOnly([
            'name', 'lastName', 'avatar', 'avatarColor', 'photo', 'gender',
            'settings', 'responsibleUid', 'responsibleName', 'responsibleSince'
          ])
          && responsibleSelfOnly()
          // Solo el propio responsable actualiza su nombre como responsable.
          && (!changedKeys().hasAny(['responsibleName'])
              || request.resource.data.get('responsibleUid', null) in [uid(), null])
          && validChildProfile())
        ||
        // Adulto vinculado que se desvincula a sí mismo.
        (uid() in resource.data.memberUids
          && uid() != resource.data.ownerUid
          && changedKeys().hasOnly([
            'memberUids', 'responsibleUid', 'responsibleName', 'responsibleSince'
          ])
          && request.resource.data.memberUids.toSet()
              == resource.data.memberUids.toSet().difference([uid()].toSet())
          && request.resource.data.get('responsibleUid', null) != uid())
        ||
        // Administrador de la familia: retira adultos de los niños de su
        // familia (sin quitar a los adultos que siguen en la familia).
        (resource.data.get('familyId', null) != null
          && isFamilyOwner(resource.data.familyId)
          && changedKeys().hasOnly([
            'memberUids', 'responsibleUid', 'responsibleName', 'responsibleSince'
          ])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.hasAll(
              getAfter(familyPath(resource.data.familyId)).data.adultUids)
          && responsibleIsMember())
        ||
        // Docente que administra una clase: agrega a la clase a un alumno al
        // que ya tiene acceso, o lo retira (perdiendo el acceso que le daba
        // la clase). `lastClassChange` indica la clase afectada.
        (uid() in resource.data.memberUids
          && changedKeys().hasOnly([
            'classIds', 'lastClassChange', 'memberUids',
            'responsibleUid', 'responsibleName', 'responsibleSince'
          ])
          && isClassOwner(request.resource.data.lastClassChange)
          && (
            (request.resource.data.classIds.toSet()
                == resource.data.get('classIds', []).toSet()
                    .union([request.resource.data.lastClassChange].toSet())
              && childId in getAfter(
                  classPath(request.resource.data.lastClassChange)).data.studentIds
              && request.resource.data.memberUids == resource.data.memberUids)
            ||
            (request.resource.data.classIds.toSet()
                == resource.data.get('classIds', []).toSet()
                    .difference([request.resource.data.lastClassChange].toSet())
              && !(childId in getAfter(
                  classPath(request.resource.data.lastClassChange)).data.studentIds)
              && resource.data.memberUids.hasAll(request.resource.data.memberUids)
              && resource.data.memberUids.toSet()
                  .difference(request.resource.data.memberUids.toSet())
                  .hasOnly(get(classPath(request.resource.data.lastClassChange))
                      .data.teacherUids.toSet())
              && responsibleIsMember())
          ))
        ||
        // Unión verificable con un código de invitación.
        (!(uid() in resource.data.memberUids)
          && changedKeys().hasOnly(['memberUids', 'joinCode'])
          && request.resource.data.memberUids.toSet()
              == resource.data.memberUids.toSet().union([uid()].toSet())
          && validInvite(request.resource.data.joinCode, childId))
      );

      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // ------------------------------------------------ caregiver_links
      match /caregiver_links/{adultUid} {
        allow read: if isMember(childId);

        allow create: if signedIn()
          && request.resource.data.adultUid == adultUid
          && request.resource.data.childId == childId
          && (
            // Vínculo del creador del perfil (mismo lote que el perfil).
            (adultUid == uid()
              && request.resource.data.permission == 'owner'
              && getAfter(childPath(childId)).data.ownerUid == uid())
            ||
            // Vínculo aceptado con invitación (mismo lote que la unión).
            (adultUid == uid()
              && request.resource.data.permission == 'caregiver'
              && validInvite(request.resource.data.invitationCode, childId)
              && request.resource.data.role
                  == get(invitationPath(request.resource.data.invitationCode)).data.role
              && uid() in getAfter(childPath(childId)).data.memberUids)
            ||
            // Al crear un perfil en una familia: vínculo autorizado (nunca
            // administrador) para cada adulto de esa familia.
            (request.resource.data.permission == 'caregiver'
              && request.resource.data.source == 'family'
              && getAfter(childPath(childId)).data.get('familyId', null) != null
              && isFamilyAdult(getAfter(childPath(childId)).data.familyId)
              && adultUid in get(familyPath(
                  getAfter(childPath(childId)).data.familyId)).data.adultUids
              && adultUid in getAfter(childPath(childId)).data.memberUids)
          );

        // Cada adulto actualiza su nombre y sus clases; el administrador del
        // perfil decide quién recibe solicitudes y quién ve el pasaporte.
        allow update: if signedIn() && (
          (adultUid == uid()
            && changedKeys().hasOnly(['adultName', 'adultEmail', 'classIds']))
          ||
          (isOwner(childId)
            && changedKeys().hasOnly(['receivesRequests', 'canViewPassport'])
            && request.resource.data.receivesRequests is bool
            && request.resource.data.canViewPassport is bool)
        );

        allow delete: if signedIn() && (
          adultUid == uid()
          || isOwner(childId)
          || isFamilyOwner(get(childPath(childId)).data.get('familyId', null))
        );
      }

      // ------------------------------------------ communication_requests
      match /communication_requests/{requestId} {
        allow read: if isMember(childId);

        allow create: if isMember(childId)
          && request.resource.data.id == requestId
          && request.resource.data.childId == childId
          && request.resource.data.createdByUid == uid()
          && request.resource.data.status == 'new'
          && request.resource.data.priority in ['normal', 'high']
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 300
          && request.resource.data.serverReceivedAt == request.time
          && !request.resource.data.keys().hasAny(['notification']);

        // Los adultos solo cambian el estado de atención.
        allow update: if isMember(childId)
          && changedKeys().hasOnly([
            'status', 'statusUpdatedAt', 'statusUpdatedByUid',
            'statusUpdatedByName', 'seenAt', 'attendingAt', 'resolvedAt', 'note'
          ])
          && request.resource.data.status in ['seen', 'attending', 'resolved']
          && request.resource.data.statusUpdatedByUid == uid();

        allow delete: if isOwner(childId);
      }

      // ------------------------------------------------ sensory_passports
      // Solo adultos vinculados a los que la familia no retiró este permiso.
      match /sensory_passports/{docId} {
        allow read, write: if isMember(childId)
          && (!exists(linkPath(childId, uid()))
              || get(linkPath(childId, uid())).data.get('canViewPassport', true));
      }

      // ----------------------------------------------- support_strategies
      match /support_strategies/{strategyId} {
        allow read: if isMember(childId);
        allow create: if isMember(childId)
          && request.resource.data.createdByUid == uid()
          && request.resource.data.childId == childId;
        allow update: if isMember(childId)
          && (resource.data.createdByUid == uid() || isOwner(childId))
          && request.resource.data.createdByUid == resource.data.createdByUid;
        allow delete: if isMember(childId)
          && (resource.data.createdByUid == uid() || isOwner(childId));
      }

      // ---------------------------------------- favorites y pictograms
      match /favorites/{favoriteId} {
        allow read, write: if isMember(childId);
      }

      match /pictograms/{pictogramId} {
        allow read, write: if isMember(childId);
      }
    }

    // ------------------------------------------------------------- families
    // Los adultos se agregan solo con una invitación validada en el servidor
    // (etapa de invitaciones). Aquí: crear, renombrar, retirar y salir.
    match /families/{familyId} {
      allow read: if signedIn() && uid() in resource.data.adultUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.adultUids == [uid()]
        && validName(request.resource.data, 60)
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'ownerUid', 'adultUids', 'adultNames', 'adultRoles',
          'createdAt'
        ]);

      allow update: if signedIn() && (
        (resource.data.ownerUid == uid()
          && changedKeys().hasOnly(['name', 'adultUids', 'adultNames', 'adultRoles'])
          && resource.data.adultUids.hasAll(request.resource.data.adultUids)
          && uid() in request.resource.data.adultUids
          && validName(request.resource.data, 60))
        ||
        (uid() in resource.data.adultUids
          && uid() != resource.data.ownerUid
          && changedKeys().hasOnly(['adultUids', 'adultNames', 'adultRoles'])
          && request.resource.data.adultUids.toSet()
              == resource.data.adultUids.toSet().difference([uid()].toSet()))
      );

      allow delete: if signedIn() && resource.data.ownerUid == uid();
    }

    // -------------------------------------------------------------- classes
    // Solo sus docentes la ven. Los alumnos nuevos llegan con invitación
    // (etapa de invitaciones); aquí el docente organiza a los alumnos que ya
    // le autorizaron (la regla del niño exige que ya tenga acceso).
    match /classes/{classId} {
      allow read: if signedIn() && uid() in resource.data.teacherUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.teacherUids == [uid()]
        && request.resource.data.studentIds.size() == 0
        && request.resource.data.archived == false
        && validName(request.resource.data, 60)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200;

      allow update: if signedIn()
        && resource.data.ownerUid == uid()
        && changedKeys().hasOnly(['name', 'description', 'archived', 'studentIds'])
        && validName(request.resource.data, 60)
        && request.resource.data.description.size() <= 200
        && request.resource.data.archived is bool
        // Un alumno por operación (alta o retiro).
        && request.resource.data.studentIds.toSet()
            .difference(resource.data.studentIds.toSet()).size() <= 1;

      // Se archiva en lugar de borrarse (conserva el historial).
      allow delete: if false;
    }

    // ------------------------------------------------ invitations (antiguas)
    // Códigos por niño de versiones anteriores. Retirados: se podían leer
    // por código sin límite de intentos. Solo se pueden listar y borrar las
    // propias; las nuevas invitaciones están en group_invitations.
    match /invitations/{code} {
      allow list: if signedIn() && resource.data.createdBy == uid();
      allow delete: if signedIn()
        && (resource.data.createdBy == uid() || isOwner(resource.data.childId));
    }

    // ------------------------------------------------ group_invitations
    // Invitaciones a familias y clases. Las crean, revocan y canjean las
    // Cloud Functions (que validan permisos, caducidad, usos e intentos).
    // El cliente solo lee las de los grupos que administra.
    match /group_invitations/{code} {
      allow read: if signedIn()
        && (resource.data.ownerUid == uid() || resource.data.createdBy == uid());
      allow write: if false;
    }

    // ----------------------------------------------------- join_requests
    // Solicitudes de incorporación: las ve quien la envió y quien la aprueba.
    // Crearlas y resolverlas solo es posible mediante las Cloud Functions.
    match /join_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.requesterUid == uid() || resource.data.approverUid == uid());
      allow write: if false;
    }

    // ------------------------------------------------------- rate_limits
    // Intentos incorrectos por cuenta: solo los usa el servidor.
    match /rate_limits/{uid} {
      allow read, write: if false;
    }
    // -------------------------------------------------- notification_tokens
    match /notification_tokens/{token} {
      allow read, delete: if signedIn() && resource.data.uid == uid();
      allow create, update: if signedIn() && request.resource.data.uid == uid();
    }

    // Todo lo demás está denegado por defecto.
  }
}
